class Solution {
public:
    bool hasAlternatingBits(int n) {
        int curr = (n&1);
        n = n/2;
        while(n>0)
        {
            int last_bit = (n&1);
            if(curr == last_bit)
            {
                return false;
            }
            else
            {
                curr = last_bit;
                n = n /2;
            }
        }
        return true;
        
    }
};
