/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* mergeTwoLists(ListNode* list1, ListNode* list2) {
        if(list1 == NULL && list2 == NULL)
            return NULL;
        if(!list1) return list2;
        if(!list2) return list1;
        
        ListNode dummy(0);
        ListNode* curr = &dummy;

        while(list1 && list2){

            if(list1->val <= list2->val){
                ListNode* l1st1next = list1->next;
                list1->next = NULL;
                curr->next = list1;
                curr = curr->next;
                list1 = l1st1next;
            }
            else{
                ListNode* l1st2next = list2->next;
                list2->next = NULL;
                curr->next = list2;
                curr = curr->next;
                list2 = l1st2next;
            }

        }
        if(list1){
            curr->next = list1;
        }
        if(list2){
            curr->next = list2;
        }
        return dummy.next;
    }
};
