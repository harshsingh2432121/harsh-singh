// by using string
class Solution {
  public:
    int compare(Node *head1, Node *head2) {
        // Code Here
        Node *p=head1,*q=head2;
        string s1="",s2="";
        while(p!=nullptr)
        {
            s1=s1+p->data;
            p=p->next;
        }
        while(q!=nullptr){
            s2=s2+q->data;
            q=q->next;
        }
        if(s1==s2)
        return 0;
        else if(s1>s2)
        return 1;
        else
        return -1;
        
    }
};
