#include<iostream>
#include<string>
using namespace std;

int password(int n,string str) {
   int up=0,low=0,num=0,sym=0;
   for (int i=0 ; str[i]!='\0' ; i++) {
    if (str[i]>='A' && str[i]<='Z')
    up++;
    else if(str[i]>='a' && str[i]<='z')
    low++;
    else if (str[i]>='0' && str[i]<='9') 
    num++;
    else 
    sym++;
   } 
   int count=0;
   if (up==0) count++;
   if (low==0) count++;
   if (num==0) count++;
   if (sym==0) count++;
   if ((n+count)>=6) return count;
   else {count=count+(6-(n+count));return count;}
}

int main() {
    int n;
    cin>>n;
    string str;
    cin>>str;
    cout<<password(n,str);
    return 0;
}
