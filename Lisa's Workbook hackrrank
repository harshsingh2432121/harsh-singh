int workbook(int n, int k, vector<int> arr) {
 int page = 1;
    int specialCount = 0;

    for (int i = 0; i < n; i++) {
        int problems = arr[i];
        int problemNumber = 1;

        while (problemNumber <= problems) {
            int lastProblem = min(problemNumber + k - 1, problems);
            if (page >= problemNumber && page <= lastProblem) {
                specialCount++;
            }
            page++;
            problemNumber += k;
        }
    }

    return specialCount;
}
